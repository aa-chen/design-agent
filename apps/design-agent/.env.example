# Chat backend: deepseek-harness (default) | mock
# VITE_CHAT_CLIENT=mock

# Vite 将 /dsh 代理到此地址（需先启动：npx @deepseek-ai/dsh web）
# VITE_DSH_PROXY_TARGET=http://127.0.0.1:3080

# 可选：覆盖 HTTP / WS 基址（默认走同源 /dsh 代理）
# VITE_DSH_HTTP_BASE=/dsh
# VITE_DSH_WS_URL=ws://127.0.0.1:5173/dsh/api/events.mux

# 可选：创建 Harness session 时的工作目录（不设则由 dsh 默认）
# VITE_DSH_CWD=/Users/you/path/to/workspace
